# Copy to .env and adjust. Every setting is documented in agents/ledger_lens/shared/config.py.

# offline | vertex | gemini_api
LL_LLM_PROVIDER=offline
# LL_GEMINI_API_KEY=
# LL_GCP_PROJECT=ledger-lens-dev
# LL_GCP_REGION=asia-southeast1

# local | gcp, per capability
LL_STORAGE_BACKEND=local
LL_RISK_BACKEND=local
LL_SAFETY_BACKEND=local
LL_RETRIEVAL_BACKEND=local

LL_ENABLE_TTS=true
LL_ENABLE_LIVE_VOICE=false
